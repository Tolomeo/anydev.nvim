{
    "runtime": {
        "vim.notify": {
            "name": "vim.notify",
            "documentation": [
                "```lua",
                "function vim.notify(msg: string, level: integer|nil, opts: table|nil)",
                "```",
                "",
                "---",
                "",
                " Displays a notification to the user.",
                "",
                " This function can be overridden by plugins to display notifications using",
                " a custom provider (such as the system notification provider). By default,",
                " writes to |:messages|.",
                "",
                "@*param* `msg` — Content of the notification to show to the user.",
                "",
                "@*param* `level` — One of the values from |vim.log.levels|.",
                "",
                "@*param* `opts` — Optional parameters. Unused by default.",
                "",
                " luacheck: no unused args"
            ],
            "meta": [
                "static"
            ],
            "type": {
                "kind": "function",
                "arguments": [
                    {
                        "name": "msg",
                        "optional": false,
                        "type": {
                            "kind": "builtin",
                            "value": "string"
                        }
                    },
                    {
                        "name": "level",
                        "optional": false,
                        "type": {
                            "kind": "union",
                            "types": [
                                {
                                    "kind": "builtin",
                                    "value": "integer"
                                },
                                {
                                    "kind": "builtin",
                                    "value": "nil"
                                }
                            ]
                        }
                    },
                    {
                        "name": "opts",
                        "optional": false,
                        "type": {
                            "kind": "union",
                            "types": [
                                {
                                    "kind": "builtin",
                                    "value": "table"
                                },
                                {
                                    "kind": "builtin",
                                    "value": "nil"
                                }
                            ]
                        }
                    }
                ],
                "generics": [],
                "name": "notify",
                "returns": []
            }
        }
    },
    "types": {},
    "modules": {}
}