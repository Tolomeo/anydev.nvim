{
    "runtime": {
        "vim.str_byteindex": {
            "name": "vim.str_byteindex",
            "documentation": [
                "```lua",
                "function vim.str_byteindex(s: string, encoding: \"utf-16\"|\"utf-32\"|\"utf-8\", index: integer, strict_indexing?: boolean)",
                "  -\u003e integer",
                "```",
                "",
                "---",
                "",
                " Convert UTF-32, UTF-16 or UTF-8 {index} to byte index.",
                " If {strict_indexing} is false",
                " then then an out of range index will return byte length",
                " instead of throwing an error.",
                "",
                " Invalid UTF-8 and NUL is treated like in |vim.str_utfindex()|.",
                " An {index} in the middle of a UTF-16 sequence is rounded upwards to",
                " the end of that sequence.",
                "",
                "@*param* `strict_indexing` — default: true",
                "",
                "```lua",
                "encoding:",
                "    | \"utf-8\"",
                "    | \"utf-16\"",
                "    | \"utf-32\"",
                "```"
            ],
            "meta": [
                "static"
            ],
            "type": {
                "kind": "function",
                "arguments": [
                    {
                        "name": "s",
                        "optional": false,
                        "type": {
                            "kind": "builtin",
                            "value": "string"
                        }
                    },
                    {
                        "name": "encoding",
                        "optional": false,
                        "type": {
                            "kind": "union",
                            "types": [
                                {
                                    "kind": "stringliteral",
                                    "value": "\"utf-8\""
                                },
                                {
                                    "kind": "stringliteral",
                                    "value": "\"utf-16\""
                                },
                                {
                                    "kind": "stringliteral",
                                    "value": "\"utf-32\""
                                }
                            ]
                        }
                    },
                    {
                        "name": "index",
                        "optional": false,
                        "type": {
                            "kind": "builtin",
                            "value": "integer"
                        }
                    },
                    {
                        "name": "strict_indexing",
                        "optional": true,
                        "type": {
                            "kind": "builtin",
                            "value": "boolean"
                        }
                    }
                ],
                "generics": [],
                "name": "str_byteindex",
                "returns": [
                    {
                        "name": "",
