{
  "$ref": "#/definitions/Lexed",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Lexed": {
      "anyOf": [
        {
          "$ref": "#/definitions/LexedFunction"
        }
      ]
    },
    "LexedFunction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/LexedFunctionArg"
              },
              {
                "$ref": "#/definitions/LexedFunctionVararg"
              }
            ]
          }
        },
        "return": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LexedFunctionReturn"
          }
        },
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LexedGeneric"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "access": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": ["name", "doc", "args", "return", "generics", "deprecated"]
    },
    "LexedGeneric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "types"]
    },
    "LexedFunctionArg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": ["name", "type", "optional"]
    },
    "LexedFunctionVararg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": ["name", "type"]
    },
    "LexedFunctionReturn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": ["name", "type", "optional"]
    }
  }
}
