{
  "$ref": "#/definitions/Symbol",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Symbol": {
      "anyOf": [
        {
          "$ref": "#/definitions/Function"
        },
        {
          "$ref": "#/definitions/Builtin"
        }
      ]
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArg"
          }
        },
        "return": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionGeneric"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "access": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": ["name", "doc", "args", "return", "generics", "deprecated"]
    },
    "FunctionGeneric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "types"]
    },
    "FunctionArg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
					"$ref": "#/definitions/Symbol"
        },
        "optional": {
          "type": "boolean"
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "type", "optional"]
    },
    "FunctionReturn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": ["name", "type", "optional"]
    },
    "Builtin": {
      "description": "https://luals.github.io/wiki/annotations/#documenting-types",
      "enum": [
        "unknown",
        "nil",
        "any",
        "boolean",
        "string",
        "number",
        "integer",
        "function",
        "table",
        "thread",
        "userdata",
        "lightuserdata"
      ],
      "type": "string"
    }
  }
}
