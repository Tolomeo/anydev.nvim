{
  "$ref": "#/definitions/Symbol",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Symbol": {
      "anyOf": [
        {
          "$ref": "#/definitions/Symbol"
        }
      ]
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArg"
          }
        },
        "return": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Generic"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "access": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": ["name", "doc", "args", "return", "generics", "deprecated"]
    },
    "Generic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "types"]
    },
    "FunctionArg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "type", "optional"]
    },
    "FunctionReturn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": ["name", "type", "optional"]
    }
  }
}
