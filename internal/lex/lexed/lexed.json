{
  "$ref": "#/definitions/Symbol",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Symbol": {
      "anyOf": [
        {
          "$ref": "#/definitions/Table"
        },
        {
          "$ref": "#/definitions/Function"
        },
        {
          "$ref": "#/definitions/Builtin"
        },
        {
          "$ref": "#/definitions/Reference"
        }
      ]
    },
    "Documentation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["function"]
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArg"
          }
        },
        "return": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionGeneric"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "access": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "overloads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionOverload"
          }
        }
      },
      "required": ["kind", "doc", "args", "return", "generics", "deprecated"]
    },
    "FunctionGeneric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
						"$ref": "#/definitions/Symbol"
          }
        }
      },
      "required": ["name", "types"]
    },
    "FunctionArg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/Symbol"
        },
        "optional": {
          "type": "boolean"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["name", "type", "optional"]
    },
    "FunctionOverload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionGeneric"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArg"
          }
        },
        "return": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["generics", "args", "return", "documentation"]
    },
    "FunctionReturn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["type"]
    },
    "Builtin": {
      "description": "https://luals.github.io/wiki/annotations/#documenting-types",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builtin"]
        },
        "value": {
          "type": "string",
          "enum": [
            "void",
            "nil",
            "any",
            "boolean",
            "string",
            "number",
            "integer",
            "function",
            "table",
            "thread",
            "userdata",
            "lightuserdata"
          ]
        }
      },
      "required": ["kind", "value"]
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reference"]
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"]
    },
    "Unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["unknown"]
        }
      },
      "required": ["kind"]
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["table"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          }
        }
      },
      "required": ["kind", "fields"]
    },
    "TableField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Symbol"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["name", "value", "documentation"]
    }
  }
}
