{
  "$ref": "#/definitions/Symbol",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Symbol": {
      "anyOf": [
        {
          "$ref": "#/definitions/Table"
        },
        {
          "$ref": "#/definitions/Function"
        },
        {
          "$ref": "#/definitions/Builtin"
        },
        {
          "$ref": "#/definitions/Reference"
        }
      ]
    },
    "Documentation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["function"]
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArgument"
          }
        },
        "returns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionGeneric"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "access": {
          "type": "string"
        },
        "overloads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionOverload"
          }
        }
      },
      "required": [
        "kind",
        "documentation",
        "arguments",
        "returns",
        "generics",
        "deprecated",
        "private",
        "protected"
      ]
    },
    "FunctionGeneric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Symbol"
          }
        }
      },
      "required": ["name", "types"]
    },
    "FunctionArgument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/Symbol"
        },
        "optional": {
          "type": "boolean"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["name", "type", "optional"]
    },
    "FunctionOverload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionGeneric"
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionArgument"
          }
        },
        "returns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionReturn"
          }
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["generics", "arguments", "returns", "documentation"]
    },
    "FunctionReturn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/Symbol"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["type"]
    },
    "Builtin": {
      "description": "https://luals.github.io/wiki/annotations/#documenting-types",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builtin"]
        },
        "value": {
          "type": "string",
          "enum": [
            "void",
            "nil",
            "any",
            "boolean",
            "string",
            "number",
            "integer",
            "function",
            "table",
            "thread",
            "userdata",
            "lightuserdata"
          ]
        }
      },
      "required": ["kind", "value"]
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reference"]
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"]
    },
    "Unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["unknown"]
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        }
      },
      "required": ["kind", "documentation"]
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["table"]
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "$ref": "#/definitions/Documentation"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          }
        }
      },
      "required": ["kind", "name", "documentation", "fields"]
    },
    "TableField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Symbol"
        },
        "private": {
          "type": "boolean"
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": ["name", "value", "private", "protected"]
    },
    "Union": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["union"]
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Symbol"
          }
        }
      },
      "required": ["kind", "types"]
    },
    "StringLiteral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["stringliteral"]
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"]
    },
    "NumericLiteral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["numericliteral"]
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["kind", "value"]
    },
    "Array": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["array"]
        },
        "items": {
          "$ref": "#/definitions/Symbol"
        }
      },
      "required": ["kind", "items"]
    },
    "Optional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["optional"]
        },
        "type": {
          "$ref": "#/definitions/Symbol"
        }
      },
      "required": ["kind", "type"]
    }
  }
}
